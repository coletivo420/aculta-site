{# Editorial project presentation; all content comes from node fields. #}
<article{{ attributes.addClass('aculta-project') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if not node.field_image.isEmpty %}
    <div class="aculta-project-image">{{ content.field_image }}</div>
  {% endif %}
  <div class="aculta-project-text">
    {% if not node.field_category.isEmpty %}
      <div class="aculta-category">{{ content.field_category }}</div>
    {% endif %}
    <h3{{ title_attributes }}><a href="{{ url }}" rel="bookmark">{{ node.field_display_title.value ?: label }}</a></h3>
    <div class="aculta-prose">{{ content.body }}</div>
    <a href="{{ url }}" class="aculta-editorial-link">{{ node.field_link_label.value ?: label }}</a>
  </div>
</article>
