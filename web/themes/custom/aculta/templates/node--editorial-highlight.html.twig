{# Field values and links remain editable content, not template copy. #}
<article{{ attributes.addClass('aculta-editorial-card') }}>
  <div class="aculta-category">{{ content.field_category }}</div>
  <h3>{{ label }}</h3>
  <div class="aculta-editorial-summary">{{ content.field_summary }}</div>
  {% if content.field_complement %}<div class="aculta-editorial-complement">{{ content.field_complement }}</div>{% endif %}
  <div class="aculta-editorial-cta">{{ content.field_link }}</div>
</article>
