<?php

/** Keep a solitary editorial highlight static using native VVJB options. */
function aculta420_preprocess_views_view_vvjb(array &$variables): void {
  if (($variables['view']?->id() ?? '') !== 'home_editorial_highlights') {
    return;
  }
  if (count($variables['rows'] ?? []) === 1) {
    $variables['options']['slide_time'] = 0;
    $variables['options']['navigation'] = 'none';
    $variables['options']['show_play_pause'] = FALSE;
    $variables['options']['show_progress_bar'] = FALSE;
    $variables['options']['show_page_counter'] = FALSE;
  }
}

/**
 * Marks editorial node body fields as opt-in prose without styling other links.
 */
function aculta420_preprocess_field(array &$variables): void {
  if (($variables['entity_type'] ?? '') !== 'node' || ($variables['field_name'] ?? '') !== 'body') {
    return;
  }

  // Only editorial content bundles opt in; other Node-backed features must
  // retain their own link styles (for example, Commerce-related content).
  $entity = $variables['element']['#object'] ?? NULL;
  if (!$entity instanceof \Drupal\node\NodeInterface
    || !in_array($entity->bundle(), ['page', 'article', 'activity', 'project', 'editorial_highlight', 'document'], TRUE)) {
    return;
  }

  if (isset($variables['attributes']) && is_object($variables['attributes'])
    && method_exists($variables['attributes'], 'addClass')) {
    $variables['attributes']->addClass('aculta-prose');
  }
  elseif (isset($variables['attributes']) && is_array($variables['attributes'])) {
    $variables['attributes']['class'][] = 'aculta-prose';
  }
}

/** Keeps the full-page login's visible label aligned with the account UX. */
function aculta420_preprocess_form_element_label(array &$variables): void {
  $element = $variables['element'];
  if (($element['#id'] ?? '') === 'edit-name'
    && \Drupal::routeMatch()->getRouteName() === 'user.login'
    && \Drupal::service('path.current')->getPath() === '/entrar') {
    $variables['title'] = ['#markup' => t('Nome de usuário ou e-mail')];
  }
}

/**
 * @file
 * Presentation hooks for the ACULTA420 theme.
 */

/**
 * Implements hook_preprocess_page().
 */
function aculta420_preprocess_page(array &$variables): void {
  $variables['institutional_home'] = \Drupal::service('path.matcher')->isFrontPage()
    && (int) (\Drupal::routeMatch()->getParameter('node')?->id() ?? 0) === (int) theme_get_setting('institution_home_nid');
  // Keep stored block placements intact; separate header responsibilities here.
  $destinations = [
    'page_title_block' => 'aculta_page_title',
    'system_breadcrumb_block' => 'aculta_breadcrumb',
    'system_menu_block:account' => 'aculta_account_menu',
    'system_powered_by_block' => 'aculta_site_credit',
    'help_block' => 'aculta_help',
  ];
  foreach ($destinations as $destination) {
    $variables[$destination] = [];
  }
  if (!isset($variables['page']['header'])) {
    return;
  }
  foreach (\Drupal\Core\Render\Element::children($variables['page']['header']) as $key) {
    $block = $variables['page']['header'][$key];
    $plugin_id = $block['#plugin_id'] ?? '';
    // Most blocks are lazy-built, so their plugin ID is not present yet.
    $lazy_builder = $block['#lazy_builder'] ?? [];
    if ($plugin_id === '' && ($lazy_builder[0] ?? '') === 'Drupal\block\BlockViewBuilder::lazyBuilder') {
      $block_id = $lazy_builder[1][0] ?? '';
      $plugin_id = \Drupal::config('block.block.' . $block_id)->get('plugin') ?? '';
    }
    $destination = $destinations[$plugin_id] ?? NULL;
    if ($destination !== NULL) {
      // Preserve the complete render array, including access and cache metadata.
      $variables[$destination][$key] = $block;
      unset($variables['page']['header'][$key]);
    }
  }
}

/**
 * Implements hook_preprocess_block().
 */
function aculta420_preprocess_block(array &$variables): void {
  $entity = $variables['elements']['content']['#block_content'] ?? NULL;
  if ($entity instanceof \Drupal\block_content\BlockContentInterface && $entity->bundle() === 'aculta_institution') {
    $variables['institution_entity'] = $entity;
    $variables['view_mode'] = $variables['elements']['content']['#view_mode'] ?? 'full';
    $variables['institution_transparency_nid'] = theme_get_setting('institution_transparency_nid');
  }
  if ($variables['plugin_id'] !== 'system_branding_block') {
    return;
  }
  $variables['site_name'] = 'Associação Cultural Antiproibicionista';
  $variables['site_slogan'] = 'Lutando por um futuro livre da proibição.';
  $logo_path = \Drupal::service('extension.list.theme')->getPath('aculta420') . '/assets/branding/aculta420/web/logo-aculta420-horizontal-branco-900x300.png';
  $logo_file = DRUPAL_ROOT . '/' . $logo_path;
  $variables['site_logo'] = is_file($logo_file) ? base_path() . $logo_path : '';
}

/**
 * Implements hook_preprocess_html().
 */
function aculta420_preprocess_html(array &$variables): void {
  // Once installed, Metatag owns editable page titles and descriptions.
  if (!\Drupal::moduleHandler()->moduleExists('metatag')) {
    $variables['head_title']['name'] = 'Associação Cultural Antiproibicionista';
    if (\Drupal::service('path.matcher')->isFrontPage()) {
      $variables['head_title'] = ['title' => 'Associação Cultural Antiproibicionista', 'name' => 'Goiânia - GO'];
    }
  }
  // Schema.org Metatag owns the validated institutional JSON-LD.
}

/**
 * Implements hook_preprocess_breadcrumb().
 */
function aculta420_preprocess_breadcrumb(array &$variables): void {
  /** @var \Drupal\aculta_portal\Domain\AcultaBreadcrumbBuilder $builder */
  $builder = \Drupal::service('aculta_portal.breadcrumb_builder');
  $variables['aculta_current_breadcrumb'] = $builder->currentTitle(\Drupal::routeMatch());
}
