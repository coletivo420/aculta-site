{# Editorial project presentation. The presenter keeps node attributes and links; the visual markup is the project-card SDC (experimental). #}
{% set title_link %}<a href="{{ url }}" rel="bookmark">{{ node.field_display_title.value ?: label }}</a>{% endset %}
{% set cta_link %}<a href="{{ url }}" class="aculta-editorial-link">{{ node.field_link_label.value ?: label }}</a>{% endset %}
<article{{ attributes.addClass('aculta-project') }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {{ include('aculta420:project-card', {
    media: node.field_image.isEmpty ? null : content.field_image,
    category: node.field_category.isEmpty ? null : content.field_category,
    title: title_link,
    summary: content.body,
    cta: cta_link
  }, with_context = false) }}
</article>
