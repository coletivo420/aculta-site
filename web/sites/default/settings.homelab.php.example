<?php

/**
 * Homelab development database example.
 * Copy this to an ignored local settings file and set ACULTA_ENV=homelab.
 * The canonical Homelab web server is Apache + PHP-FPM. This file configures
 * Drupal runtime settings only; VirtualHost configuration remains external.
 * Production remains MariaDB and must use its own external settings/credentials.
 */
$aculta_environment = getenv('ACULTA_ENV') ?: 'homelab';
if ($aculta_environment !== 'homelab') {
  return;
}

$databases['default']['default'] = [
  'driver' => 'sqlite',
  'database' => dirname(DRUPAL_ROOT) . '/var/database/aculta-runtime.sqlite',
  'prefix' => '',
];

// The seven homelab hostnames are handled by the project's normal local
// settings and Domain aliases. No production hostname is redirected here.
// Turnstile credentials must be supplied by the PHP-FPM/CLI environment via
// TURNSTILE_KEYS_JSON as Base64-encoded JSON. Do not silently substitute
// public test keys: Cloudflare displays a testing notice for those keys, and a
// missing production key must be fixed in the environment instead of weakening
// the challenge.


/**
 * Keep Drupal-generated runtime files private to the application users.
 *
 * The setgid bit preserves the shared group on new directories. Default ACLs
 * on the Homelab runtime paths still grant the CLI user the access it needs.
 * These values prevent cache rebuilds from recreating writable directories as
 * 0777. Apache/PHP-FPM ownership and ACLs must be reviewed independently in
 * Homelab and production.
 */
$settings['file_chmod_directory'] = 02770;
$settings['file_chmod_file'] = 0660;

// Core's default PHP storage explicitly chmods compiled Twig directories to
// 0777, ignoring these file-system settings. Override only the Twig bin in
// Homelab so cache creation and cleanup keep directories at 02770.
$settings['php_storage']['twig']['class'] = \Drupal\aculta_portal\PhpStorage\RestrictedTwigStorage::class;
