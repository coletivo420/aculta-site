# Drupal Core user.login route/form.
msgid "Log in"
msgstr "Entrar"

msgid "Enter your username or email address."
msgstr "Informe seu nome de usuário ou endereço de e-mail."

msgid "Unrecognized username or password. <a href=\":password\">Forgot your password?</a>"
msgstr "Nome de usuário ou senha incorretos. <a href=\":password\">Esqueceu sua senha?</a>"

msgid "Password"
msgstr "Senha"

msgid "Enter the password that accompanies your username."
msgstr "Digite a senha da sua conta."

# Drupal Core user.pass route/form.
msgid "Reset your password"
msgstr "Redefinir sua senha"

msgid "Username or email address"
msgstr "Nome de usuário ou endereço de e-mail"

msgid "Password reset instructions will be sent to your registered email address."
msgstr "As instruções para redefinir sua senha serão enviadas para o endereço de e-mail cadastrado."

msgid "Password reset instructions will be mailed to %email. You must log out to use the password reset link in the email."
msgstr "As instruções para redefinir sua senha serão enviadas para %email. Você precisa sair da conta para usar o link de redefinição recebido por e-mail."

msgid "Submit"
msgstr "Enviar"

msgid "Further instructions have been sent to your email address."
msgstr "Enviamos instruções adicionais para o seu endereço de e-mail."
