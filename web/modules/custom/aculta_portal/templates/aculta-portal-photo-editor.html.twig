<div class="aculta-account-photo" data-aculta-photo-editor>
  <button class="aculta-account-photo__trigger" type="button" data-aculta-photo-open aria-haspopup="dialog" aria-controls="aculta-account-photo-dialog" aria-label="{{ 'Alterar foto de perfil de @name'|t({'@name': display_name}) }}">
    {{ photo }}
    <span class="aculta-account-photo__edit-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M14.7 5.3 18.7 9.3M4 20l4.2-.9L19.4 7.9a2.1 2.1 0 0 0-3-3L5.2 16.1 4 20Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
      </svg>
    </span>
  </button>

  {# The open attribute provides an inline form fallback when JavaScript is unavailable. #}
  <dialog class="aculta-account-photo__dialog" id="aculta-account-photo-dialog" open data-aculta-photo-dialog aria-labelledby="aculta-account-photo-title">
    <div class="aculta-account-photo__panel">
      <button class="aculta-account-photo__close" type="button" data-aculta-photo-close aria-label="{{ 'Fechar'|t }}">&times;</button>
      <h2 id="aculta-account-photo-title" tabindex="-1">{{ 'Alterar foto do perfil'|t }}</h2>
      <p>{{ 'Escolha uma imagem e ajuste o enquadramento antes de salvar.'|t }}</p>
      {{ photo_form }}
    </div>
  </dialog>
</div>
