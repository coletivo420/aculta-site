<section class="aculta-account" data-aculta-account-layout aria-busy="false">
  <header class="aculta-account__header">
    <h1>Minha conta</h1>
    <p>Área pessoal</p>
  </header>
  <div class="aculta-account__layout">
    <nav class="aculta-account__nav" aria-label="Minha conta">
      <h2 class="visually-hidden">Navegação da conta</h2>
      {{ menu }}
    </nav>
    <section class="aculta-account__content" data-aculta-account-content aria-labelledby="aculta-account-section-title" aria-busy="false" role="region">
      <h2 id="aculta-account-section-title" tabindex="-1">{{ section_title }}</h2>
      <div class="aculta-account__body">{{ content }}</div>
    </section>
  </div>
  <p class="aculta-account__loading" data-aculta-account-loading hidden>Carregando…</p>
  <p class="aculta-account__status" data-aculta-account-status aria-live="polite" aria-atomic="true"></p>
</section>
