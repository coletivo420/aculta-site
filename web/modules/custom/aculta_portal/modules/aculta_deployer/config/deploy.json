{
  "tool": "aculta-deployer",
  "scope": [
    "^config/sync/(.+/)?[^/]+\\.yml$",
    "^scripts/content/.+\\.json$"
  ],
  "drop": [
    "^config/sync/domain_alias\\.alias\\..*_(toca_net_br|test_8080)\\.yml$"
  ],
  "host_rules": [
    {
      "from": "aculta.toca.net.br",
      "to": "aculta.org",
      "comment": "Host de teste (*.aculta.toca.net.br) para produção (*.aculta.org). Preserva o prefixo do subdomínio."
    }
  ],
  "blocking_kinds": [
    "canonical",
    "sitemap"
  ],
  "max_bytes": 2097152,
  "robots_policy": {
    "production": {
      "x_robots_tag": null,
      "hosts": [
        "https://aculta.org/",
        "https://conta.aculta.org/",
        "https://apoio.aculta.org/",
        "https://coletivo420.aculta.org/",
        "https://wiki420.aculta.org/",
        "https://loja.aculta.org/",
        "https://cursos.aculta.org/"
      ],
      "note": "Indexação ativa em todos os domínios e subdomínios de produção. Noindex de páginas privadas da conta permanece no Portal (meta robots por rota).",
      "private_probes": [
        "https://conta.aculta.org/entrar",
        "https://conta.aculta.org/conta-interna",
        "https://conta.aculta.org/dados",
        "https://conta.aculta.org/seguranca",
        "https://conta.aculta.org/conexoes",
        "https://conta.aculta.org/meus-cursos",
        "https://aculta.org/painel-administrativo",
        "https://aculta.org/cart",
        "https://aculta.org/checkout"
      ],
      "private_note": "Caminhos privados (conta, login, painel, carrinho e checkout) devem ter noindex (meta robots ou X-Robots-Tag) ou status 401/403/404/410. O noindex é mantido no Portal por rota; o deployer apenas confere."
    },
    "test": {
      "x_robots_tag": "noindex, nofollow, noarchive",
      "hosts": [
        "https://aculta.toca.net.br/",
        "https://apoio.aculta.toca.net.br/",
        "https://coletivo420.aculta.toca.net.br/",
        "https://wiki420.aculta.toca.net.br/"
      ],
      "note": "Servidor de testes não indexável."
    }
  },
  "sitemap": {
    "production": {
      "index_url": "https://aculta.org/sitemap.xml",
      "index_base": "https://aculta.org",
      "note": "Índice central em produção. Os filhos listam URLs canônicas de produção de todos os purposes indexáveis."
    },
    "test": {
      "index_url": "https://aculta.toca.net.br/sitemap.xml",
      "index_base": "https://aculta.toca.net.br",
      "note": "Índice no servidor de testes. Os filhos continuam com URLs canônicas de produção (noindex no servidor de testes)."
    }
  },
  "environments": {
    "production": {
      "site": "https://aculta.org"
    },
    "test": {
      "site": "https://aculta.toca.net.br"
    }
  },
  "environment_bound": [
    {
      "file": "config/sync/smtp.settings.yml",
      "reason": "SMTP2GO ligado e remetente por ambiente"
    },
    {
      "file": "config/sync/system.mail.yml",
      "reason": "backend de e-mail: SMTP em produção e teste"
    },
    {
      "file": "config/sync/system.site.yml",
      "reason": "e-mail do site por ambiente"
    },
    {
      "file": "config/sync/webform.webform.aculta_contact.yml",
      "reason": "remetente do formulário de contato por ambiente"
    },
    {
      "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
      "reason": "gateway Mercado Pago ativo quando as credenciais do ambiente existem"
    },
    {
      "file": "config/sync/system.logging.yml",
      "reason": "erros ocultos na tela em todos os ambientes"
    }
  ],
  "profiles": {
    "production": {
      "description": "Transição para produção no build de produção (aculta-deployer build --target production).",
      "rules": [
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_on: .*$",
          "with": "smtp_on: true"
        },
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_from: .*$",
          "with": "smtp_from: 'naoresponda@aculta.org'"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  default: .*$",
          "with": "  default: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  webform: .*$",
          "with": "  webform: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.site.yml",
          "pattern": "^mail: .*$",
          "with": "mail: naoresponda@aculta.org"
        },
        {
          "file": "config/sync/webform.webform.aculta_contact.yml",
          "pattern": "^      from_mail: .*$",
          "with": "      from_mail: naoresponda@aculta.org"
        },
        {
          "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
          "pattern": "^status: .*$",
          "with": "status: true"
        },
        {
          "file": "config/sync/system.logging.yml",
          "pattern": "^error_level: .*$",
          "with": "error_level: hide"
        }
      ]
    },
    "test": {
      "description": "Configuração do servidor de testes (aculta-deployer build --target test). Remetente de teste.",
      "rules": [
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_on: .*$",
          "with": "smtp_on: true"
        },
        {
          "file": "config/sync/smtp.settings.yml",
          "pattern": "^smtp_from: .*$",
          "with": "smtp_from: 'naoresponda@toca.net.br'"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  default: .*$",
          "with": "  default: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.mail.yml",
          "pattern": "^  webform: .*$",
          "with": "  webform: SMTPMailSystem"
        },
        {
          "file": "config/sync/system.site.yml",
          "pattern": "^mail: .*$",
          "with": "mail: naoresponda@toca.net.br"
        },
        {
          "file": "config/sync/webform.webform.aculta_contact.yml",
          "pattern": "^      from_mail: .*$",
          "with": "      from_mail: naoresponda@toca.net.br"
        },
        {
          "file": "config/sync/commerce_payment.commerce_payment_gateway.mercado_pago.yml",
          "pattern": "^status: .*$",
          "with": "status: true"
        },
        {
          "file": "config/sync/system.logging.yml",
          "pattern": "^error_level: .*$",
          "with": "error_level: hide"
        }
      ]
    }
  }
}
